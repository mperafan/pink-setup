        "toolbar.background": "#fff5fa",
        "tab_bar.background": "#fbeef5",
        "tab.inactive_background": "#fbeef5",
        "tab.active_background": "#fff5fa",

        "editor.background": "#fff5fa",
        "editor.foreground": "#2a2430",
        "editor.gutter.background": "#fff5fa",
        "editor.line_number": "#c9b8c4",
        "editor.active_line_number": "#ff5faf",
        "editor.active_line.background": "#ffafd7",
        "editor.highlighted_line.background": "#ffafd7",
        "editor.indent_guide": "#f3dce9",
        "editor.indent_guide_active": "#ffafd7",
        "scrollbar.thumb.background": "#ff5faf40",

        "error": "#ff5f5f",
        "warning": "#ff5faf",
        "success": "#a8306e",
        "info": "#7a5cc0",
        "hint": "#a69aa8",
        "created": "#a8306e",
        "modified": "#ff5faf",
        "deleted": "#ff5f5f",

        "terminal.background": "#fff5fa",
        "terminal.foreground": "#2a2430",
        "terminal.ansi.black": "#2a2430",
        "terminal.ansi.red": "#ff5f5f",
        "terminal.ansi.green": "#a8306e",
        "terminal.ansi.yellow": "#b5651d",
        "terminal.ansi.blue": "#ff5faf",
        "terminal.ansi.bright_blue": "#ff5faf",
        "terminal.ansi.magenta": "#ff5faf",
        "terminal.ansi.cyan": "#7a5cc0",
        "terminal.ansi.white": "#fbeef5",

        "players": [
          { "cursor": "#ff5faf", "background": "#ff5faf", "selection": "#ff5faf33" }
        ],

        "syntax": {
          "keyword": { "color": "#ff5faf", "font_weight": 700 },
          "function": { "color": "#a8306e" },
          "string": { "color": "#7a5cc0" },
          "number": { "color": "#5f6fc0" },
          "boolean": { "color": "#5f6fc0" },
          "type": { "color": "#5f6fc0" },
          "constant": { "color": "#5f6fc0" },
          "comment": { "color": "#a69aa8", "font_style": "italic" },
          "variable": { "color": "#2a2430" },
          "property": { "color": "#8a4fa8" },
          "operator": { "color": "#ff5faf" },
          "punctuation": { "color": "#6e6475" }
        }
      }
    }
  ]
}
